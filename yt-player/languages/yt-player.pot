#: inc/Page/Settings.php:48
msgid ""
"<div style=\"background-color: #e9eaec; padding: 15px 20px; margin-bottom: 20px; border-radius: 4px;\">\r\n"
"                            <div style=\"display: flex; align-items: center; gap: 15px; margin-bottom: 10px;\">\r\n"
"                                <code id=\"ytp-quick-shortcode\" style=\"background: #ffffff; padding: 6px 12px; border: 1px solid #3567d6; color: #3567d6; font-size: 14px; border-radius: 2px;\">[ytp]Your Video URL[/ytp]</code>\r\n"
"                                <button type=\"button\" style=\"background: transparent; border: none; cursor: pointer; padding: 0; color: #1e1e1e; display: flex; align-items: center;\" onclick=\"var codeEl = document.getElementById('ytp-quick-shortcode'); navigator.clipboard.writeText('[ytp]Your Video URL[/ytp]').then(function(){ var oldText = codeEl.innerText; codeEl.innerText = 'Copied!'; setTimeout(function(){ codeEl.innerText = oldText; }, 2000); });\" title=\"Copy to clipboard\">\r\n"
"                                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"></rect><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path></svg>\r\n"
"                                </button>\r\n"
"                            </div>\r\n"
"                            <span style=\"font-size: 14px; color: #3c434a; display: block;\">Simply copy the shortcode above and place your YouTube video URL between the <strong>[ytp]</strong> and <strong>[/ytp]</strong> tags. You can paste it in any post or page.</span>\r\n"
"                        </div>"
